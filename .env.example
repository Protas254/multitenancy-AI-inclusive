# =============================================================
#  StoreGrid Retail Cloud - Monorepo Environment Configuration
# =============================================================

# Canonical Production URL (Used for SEO, Canonicals, Sitemaps, and Social Sharing)
VITE_SITE_URL=https://storegrid.co.ke
NEXT_PUBLIC_SITE_URL=https://storegrid.co.ke

# Django API Base URL
VITE_API_URL=https://api.storegrid.co.ke/api/v1
NEXT_PUBLIC_API_URL=https://api.storegrid.co.ke/api/v1

# Django Server Environment (Set in server/ or deployment environment)
DJANGO_SECRET_KEY=change-in-production-to-a-secure-random-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,storegrid.co.ke,www.storegrid.co.ke,api.storegrid.co.ke
CSRF_TRUSTED_ORIGINS=https://storegrid.co.ke,https://www.storegrid.co.ke,https://api.storegrid.co.ke
CORS_ALLOWED_ORIGINS=https://storegrid.co.ke,https://www.storegrid.co.ke,https://api.storegrid.co.ke

# Production SMTP Configuration (Use Gmail App Password on the server)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=storegridkenya@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password-here
DEFAULT_FROM_EMAIL=StoreGrid Cloud <storegridkenya@gmail.com>
SERVER_EMAIL=StoreGrid Cloud <storegridkenya@gmail.com>
