# =============================================================
#  StockGrid Retail Cloud - Monorepo Environment Configuration
# =============================================================

# Canonical Production URL (Used for SEO, Canonicals, Sitemaps, and Social Sharing)
VITE_SITE_URL=https://stockgrid.africa
NEXT_PUBLIC_SITE_URL=https://stockgrid.africa

# Django API Base URL
VITE_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Django Server Environment (Set in server/ or deployment environment)
DJANGO_SECRET_KEY=change-in-production-to-a-secure-random-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,stockgrid.africa,api.stockgrid.africa
